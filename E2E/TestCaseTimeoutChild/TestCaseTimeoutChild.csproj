<Project Sdk="Godot.NET.Sdk/4.7.1-outpostia.2">
    <PropertyGroup>
        <TargetFramework>net9.0</TargetFramework>
        <RootNamespace>GdUnit4.E2E.TestCaseTimeout</RootNamespace>
        <AssemblyName>TestCaseTimeoutChild</AssemblyName>
    </PropertyGroup>

    <PropertyGroup>
        <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
        <GenerateRuntimeConfigurationFiles>true</GenerateRuntimeConfigurationFiles>
        <NoWarn>NU1605,CS8785</NoWarn>
        <VSTestTestAdapterPath>none</VSTestTestAdapterPath>
        <TestFramework>GdUnit4</TestFramework>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
        <ProjectReference Include="..\..\Api\GdUnit4Api.csproj" />
        <ProjectReference Include="..\..\TestAdapter\GdUnit4TestAdapter.csproj" />
    </ItemGroup>
</Project>
